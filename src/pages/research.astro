---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { themes } from '../data/site';

const all = (await getCollection('highlights')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const groups = (Object.keys(themes) as (keyof typeof themes)[])
  .map((key) => ({ key, ...themes[key], entries: all.filter((e) => e.data.theme === key) }))
  .filter((g) => g.entries.length > 0);
---

<Base title="Research" description="Research highlights from the UCLA Plasma Simulation Group: plasma-based acceleration, high-performance simulation and data-driven plasma physics.">
  <section class="border-b border-slate-200 bg-gradient-to-b from-brand-50/60 to-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h1 class="text-4xl font-semibold">Research</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
        We combine first-principles kinetic simulation, high-performance computing and data-driven methods to
        understand and design plasma systems.
      </p>
      <nav aria-label="Research themes" class="mt-6 flex flex-wrap gap-2">
        {groups.map((g) => (
          <a href={`#${g.key}`} class="rounded-full border border-slate-300 bg-white px-4 py-1.5 text-sm text-slate-700 no-underline hover:border-brand-600 hover:text-brand-700">
            {g.title}
          </a>
        ))}
      </nav>
    </div>
  </section>

  {groups.map((g) => (
    <section id={g.key} class="mx-auto max-w-6xl scroll-mt-20 px-4 pt-16 sm:px-6">
      <h2 class="text-3xl font-semibold">{g.title}</h2>
      <p class="mt-3 max-w-3xl text-slate-600">{g.blurb}</p>

      <div class="mt-10 space-y-14">
        {g.entries.map(async (entry, i) => {
          const { data } = entry;
          const { Content } = await import('astro:content').then((m) => m.render(entry));
          // Very wide figures (e.g. a single row of panels) get the full width, text below.
          const wide = data.image ? data.image.width / data.image.height > 2.2 : false;
          return (
            <article class:list={['grid items-center gap-8', !wide && 'md:grid-cols-2']}>
              <figure class:list={['rounded-xl border border-slate-200 bg-white p-4', !wide && i % 2 === 1 && 'md:order-2']}>
                <Figure
                  image={data.image}
                  alt={data.imageAlt}
                  class={data.image ? 'max-h-[440px]' : 'min-h-56'}
                  sizes={wide ? '(min-width: 1152px) 1100px, 100vw' : undefined}
                  widths={wide ? [800, 1400, 2000] : undefined}
                />
                <figcaption class="mt-3 text-xs text-slate-500">{data.figureCredit}</figcaption>
              </figure>
              <div class:list={[wide && 'max-w-3xl']}>
                <h3 class="text-2xl leading-snug font-semibold">{data.title}</h3>
                <div class="mt-4 leading-relaxed text-slate-700">
                  <Content />
                </div>
                <div class="mt-5 border-l-2 border-brand-600 pl-4 text-sm">
                  <a href={`https://doi.org/${data.paper.doi}`} class="font-medium text-slate-900 no-underline hover:text-brand-700">
                    {data.paper.title}
                  </a>
                  <p class="mt-1 text-slate-500">{data.paper.authors}</p>
                  <p class="text-slate-500 italic">{data.paper.citation}</p>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  ))}
</Base>
