---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { byDoi, cite, shortAuthors } from '../data/publications';

const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);
const slug = (id: string) => id.replace(/^\d+-/, '');
---

<Base title="Research" description="Research areas of the UCLA Plasma Simulation Group: simulation software and high-performance computing, AI/ML for plasma physics, plasma-based acceleration, nonlinear optics of plasmas and plasma astrophysics.">
  <section class="border-b border-slate-200 bg-gradient-to-b from-brand-50/60 to-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h1 class="text-4xl font-semibold">Research</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
        We combine first-principles kinetic simulation, high-performance computing, and AI/ML to tackle fundamental and applied problems in plasma physics, from the laboratory to the cosmos.
      </p>
      <nav aria-label="Research areas" class="mt-6 flex flex-wrap gap-2">
        {areas.map((a) => (
          <a href={`#${slug(a.id)}`} class="rounded-full border border-slate-300 bg-white px-4 py-1.5 text-sm text-slate-700 no-underline hover:border-brand-600 hover:text-brand-700">
            {a.data.title}
          </a>
        ))}
      </nav>
    </div>
  </section>

  {areas.map(async (area) => {
    const { data } = area;
    const { Content } = await render(area);
    const papers = data.publications.map(byDoi);
    const hasText = Boolean(area.body?.trim());
    return (
      <section id={slug(area.id)} class="scroll-mt-20 border-b border-slate-100 py-16 last:border-b-0">
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <h2 class="text-3xl font-semibold">{data.title}</h2>
          <p class="mt-2 max-w-3xl text-lg text-slate-500">{data.subtitle}</p>

          <div class="mt-8 grid items-start gap-10 lg:grid-cols-5">
            <div class="area-text leading-relaxed text-slate-700 lg:col-span-3">
              {hasText ? <Content /> : <p class="text-slate-400 italic">Description coming soon.</p>}
            </div>
            <figure class="rounded-xl border border-slate-200 bg-white p-4 lg:col-span-2">
              <Figure
                image={data.image}
                alt={data.imageAlt}
                class={data.image ? 'max-h-[420px]' : 'aspect-[4/3]'}
                sizes="(min-width: 1024px) 440px, 100vw"
              />
              {data.figureCredit && <figcaption class="mt-3 text-xs text-slate-500">{data.figureCredit}</figcaption>}
            </figure>
          </div>

          {papers.length > 0 && (
            <div class="mt-10">
              <h3 class="font-sans text-sm font-semibold tracking-wide text-slate-500 uppercase">Recent publications</h3>
              <ol class="mt-3 divide-y divide-slate-200 border-y border-slate-200">
                {papers.map((p) => (
                  <li class="py-3">
                    <a href={`https://doi.org/${p.doi}`} class="font-medium text-slate-900 no-underline hover:text-brand-700">{p.title}</a>
                    <p class="mt-1 text-sm text-slate-500">{shortAuthors(p.authors)} · <span class="italic">{cite(p)}</span></p>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>
      </section>
    );
  })}
</Base>
