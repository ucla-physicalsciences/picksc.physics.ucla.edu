---
import Base from '../layouts/Base.astro';
import EntryLine from '../components/EntryLine.astro';
import { presentations } from '../data/talks';
import { fileLink } from '../data/files';

const { workshops, talks, proceedings } = presentations;
const sections = [
  ...workshops.map((w) => ({ id: `workshop-${w.year}`, title: `${w.title} (${w.year})` })),
  { id: 'talks', title: 'Selected talks' },
  { id: 'proceedings', title: 'Conference proceedings' },
];
---

<Base title="Presentations" description="Talks, workshop slides and conference proceedings from the UCLA Plasma Simulation Group.">
  <section class="border-b border-slate-200 bg-gradient-to-b from-brand-50/60 to-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <p class="text-sm"><a href="/publications" class="no-underline hover:underline">&larr; Publications</a></p>
      <h1 class="mt-2 text-4xl font-semibold">Presentations</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
        Slides from workshops and conference talks by the group and our collaborators, and conference proceedings.
      </p>
      <nav aria-label="Sections" class="mt-6 flex flex-wrap gap-2">
        {sections.map((s) => (
          <a href={`#${s.id}`} class="rounded-full border border-slate-300 bg-white px-4 py-1.5 text-sm text-slate-700 no-underline hover:border-brand-600 hover:text-brand-700">{s.title}</a>
        ))}
      </nav>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    {workshops.map((w) => (
      <section id={`workshop-${w.year}`} class="scroll-mt-20 pt-12">
        <h2 class="text-2xl font-semibold">{w.title} ({w.year})</h2>
        {w.agenda && (() => { const a = fileLink(w.agenda!); return <p class="mt-2 text-sm"><a href={a.href}>Workshop agenda</a> <span class="text-slate-500">({a.label})</span></p>; })()}
        {w.sessions.map((s) => (
          <div class="mt-8">
            <h3 class="font-sans text-sm font-semibold tracking-wide text-slate-500 uppercase">{s.title}</h3>
            <ul class="mt-1 divide-y divide-slate-100">
              {s.talks.map((t) => <EntryLine entry={t} />)}
            </ul>
          </div>
        ))}
      </section>
    ))}

    <section id="talks" class="scroll-mt-20 pt-14">
      <h2 class="border-b border-slate-200 pb-2 text-2xl font-semibold">Selected talks</h2>
      <ul class="divide-y divide-slate-100">
        {talks.map((t) => <EntryLine entry={t} />)}
      </ul>
    </section>

    <section id="proceedings" class="scroll-mt-20 pt-14">
      <h2 class="border-b border-slate-200 pb-2 text-2xl font-semibold">Conference proceedings</h2>
      <ul class="divide-y divide-slate-100">
        {proceedings.map((t) => <EntryLine entry={t} />)}
      </ul>
    </section>
  </div>
</Base>
