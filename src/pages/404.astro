---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="mx-auto max-w-3xl px-4 py-24 sm:px-6">
    <p class="font-sans text-sm font-semibold text-brand-700">404</p>
    <h1 class="mt-2 text-4xl font-semibold">Page not found</h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-600">
      The page you were looking for isn't here. It may have moved when the site was redesigned.
    </p>
    <p class="mt-6 text-slate-700">
      Try the <a href="/">homepage</a>, our <a href="/research">research</a>, <a href="/publications">publications</a>
      or <a href="/software">software</a>.
    </p>
  </section>
</Base>
