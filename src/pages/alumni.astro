---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import { team, linksFor } from '../data/team';
import { dissertationOf } from '../data/dissertations';

// One section per role; a section with nobody in it is not shown.
const sections = [
  { id: 'phd', title: 'PhD graduates', role: 'PhD' },
  { id: 'postdocs', title: 'Postdocs', role: 'Postdoc' },
  { id: 'visitors', title: 'Visitors', role: 'Visitor' },
]
  .map((s) => ({ ...s, people: team.alumni.filter((a) => a.role === s.role) }))
  .filter((s) => s.people.length > 0);
const contact = team.pis.find((p) => p.email)?.email;
---

<Base title="Alumni" description="Former members of the UCLA Plasma Simulation Group and where they went next.">
  <section class="border-b border-slate-200 bg-gradient-to-b from-brand-50/60 to-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <p class="text-sm"><a href="/team" class="no-underline hover:underline">&larr; Team</a></p>
      <h1 class="mt-2 text-4xl font-semibold">Alumni</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
        We are proud of the students, postdocs and visitors who have passed through the group, and of everything they have
        gone on to do. Alumni, please keep in touch: let us know where you are now, or send us a few words about your time
        here{contact && <> at <a href={`mailto:${contact}`}>{contact}</a></>}.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    {sections.map((s) => (
      <section id={s.id} class="scroll-mt-20 pt-12">
        <h2 class="text-2xl font-semibold">{s.title}</h2>
        <ul class="mt-2 grid gap-x-10 md:grid-cols-2">
          {s.people.map((a) => {
            const thesis = dissertationOf(a.name);
            const links = [...(thesis?.url ? [{ label: 'Dissertation', href: thesis.url }] : []), ...linksFor(a)];
            return (
              <li class:list={['flex gap-4 border-b border-slate-200 py-5', a.quote && 'md:col-span-2']}>
                <Avatar person={a} size={56} />
                <div class="min-w-0">
                  <h3 class="font-sans text-base font-semibold text-slate-900">{a.name}</h3>
                  {a.years && <p class="text-sm text-slate-500">{a.years}</p>}
                  {a.after && (
                    <p class="mt-1 text-sm text-slate-700"><span class="text-slate-500">Next:</span> {a.after}</p>
                  )}
                  {links.length > 0 && (
                    <p class="mt-1 flex flex-wrap gap-x-3 text-xs">
                      {links.map((l) => <a href={l.href} class="no-underline hover:underline">{l.label}</a>)}
                    </p>
                  )}
                  {a.quote && (
                    <blockquote class="mt-3 max-w-3xl border-l-2 border-brand-300 pl-4 text-sm leading-relaxed text-slate-600 italic">{a.quote}</blockquote>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</Base>
