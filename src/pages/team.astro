---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import { team, linksFor } from '../data/team';

const sections = [
  { id: 'pis', title: 'Principal investigators' },
  ...team.groups.map((g) => ({ id: g.title.toLowerCase().replace(/[^a-z]+/g, '-'), title: g.title })),
  { id: 'collaborators', title: 'Collaborators' },
];
const groupId = (title: string) => title.toLowerCase().replace(/[^a-z]+/g, '-');
---

<Base title="Team" description="Members and collaborators of the UCLA Plasma Simulation Group.">
  <section class="border-b border-slate-200 bg-gradient-to-b from-brand-50/60 to-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h1 class="text-4xl font-semibold">Team</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
        We are physicists, computational scientists and students in the UCLA Departments of Physics &amp; Astronomy and
        Electrical &amp; Computer Engineering. Interested in joining us? See <a href="/join-us">Join us</a>.
      </p>
      <nav aria-label="Team sections" class="mt-6 flex flex-wrap gap-2">
        {sections.map((s) => (
          <a href={`#${s.id}`} class="rounded-full border border-slate-300 bg-white px-4 py-1.5 text-sm text-slate-700 no-underline hover:border-brand-600 hover:text-brand-700">{s.title}</a>
        ))}
      </nav>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Principal investigators -->
    <section id="pis" class="scroll-mt-20 pt-14">
      <h2 class="text-2xl font-semibold">Principal investigators</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {team.pis.map((p) => (
          <article class="flex flex-col items-center gap-6 rounded-xl border border-slate-200 bg-white p-6 text-center sm:flex-row sm:items-start sm:text-left">
            <Avatar person={p} size={128} />
            <div>
              <h3 class="text-xl font-semibold">{p.name}</h3>
              <p class="mt-1 text-sm font-medium text-brand-700">{p.role}</p>
              {p.title && <p class="mt-1 text-sm text-slate-600">{p.title}</p>}
              {p.bio && <p class="mt-3 text-sm leading-relaxed text-slate-700">{p.bio}</p>}
              <p class="mt-3 flex flex-wrap justify-center gap-x-4 gap-y-1 text-sm sm:justify-start">
                {linksFor(p).map((l) => <a href={l.href} class="no-underline hover:underline">{l.label}</a>)}
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Members by group -->
    {team.groups.map((g) => (
      <section id={groupId(g.title)} class="scroll-mt-20 pt-14">
        <h2 class="text-2xl font-semibold">{g.title}</h2>
        <div class="mt-6 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
          {g.members.map((p) => (
            <article class="flex flex-col items-center text-center">
              <Avatar person={p} size={120} />
              <h3 class="mt-4 font-sans text-base font-semibold">{p.name}</h3>
              {p.role && <p class="text-sm text-slate-500">{p.role}</p>}
              {p.focus && <p class="mt-1 text-sm text-slate-600">{p.focus}</p>}
              <p class="mt-2 flex flex-wrap justify-center gap-x-3 text-xs">
                {linksFor(p).map((l) => <a href={l.href} class="no-underline hover:underline">{l.label}</a>)}
              </p>
            </article>
          ))}
        </div>
      </section>
    ))}

    <!-- Collaborators -->
    <section id="collaborators" class="scroll-mt-20 pt-14">
      <h2 class="text-2xl font-semibold">Collaborators</h2>
      <p class="mt-4 leading-relaxed text-slate-700">
        {team.collaborators.map((p, i) => (
          <>
            {i > 0 && <span class="px-2 text-slate-300">·</span>}
            {linksFor(p)[0] ? <a href={linksFor(p)[0].href} class="no-underline hover:underline">{p.name}</a> : p.name}
            {p.title && <span class="text-slate-500"> ({p.title})</span>}
          </>
        ))}
      </p>
    </section>

    <!-- Link to alumni page -->
    <section class="py-14">
      <a href="/alumni" class="group flex items-center justify-between gap-6 rounded-xl border border-slate-200 bg-brand-50/50 p-6 no-underline hover:border-brand-600">
        <div>
          <h2 class="text-2xl font-semibold text-slate-900">Alumni</h2>
          <p class="mt-1 text-slate-600">Former students, postdocs and researchers of the group, and where they went next.</p>
        </div>
        <span class="shrink-0 text-2xl text-brand-700 transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
      </a>
    </section>
  </div>
</Base>
