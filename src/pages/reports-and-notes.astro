---
import Base from '../layouts/Base.astro';
import EntryLine from '../components/EntryLine.astro';
import { reports } from '../data/talks';
---

<Base title="Reports and Notes" description="Technical reports, notes and proposals from the UCLA Plasma Simulation Group.">
  <section class="border-b border-slate-200 bg-gradient-to-b from-brand-50/60 to-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <p class="text-sm"><a href="/publications" class="no-underline hover:underline">&larr; Publications</a></p>
      <h1 class="mt-2 text-4xl font-semibold">Reports and notes</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
        Technical reports, notes on our codes and algorithms, and proposals.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    {reports.map((s) => (
      <section class="pt-12">
        <h2 class="border-b border-slate-200 pb-2 text-2xl font-semibold">{s.section}</h2>
        <ul class="divide-y divide-slate-100">
          {s.items.map((e) => <EntryLine entry={e} />)}
        </ul>
      </section>
    ))}
  </div>
</Base>
