---
import logo from '../assets/group-logo.svg';
import { nav } from '../data/site';

// Pages are built as files (/team.html, /index.html); compare without the extension or a trailing slash.
const path = Astro.url.pathname.replace(/(\/index)?\.html$|\/$/, '');
---

<header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-3 sm:px-6">
    <a href="/" class="flex min-w-0 shrink items-center" aria-label="UCLA Plasma Simulation Group home">
      <img
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt="UCLA Plasma Simulation Group"
        class="h-auto max-h-12 w-full max-w-[400px] object-contain object-left"
      />
    </a>

    <nav aria-label="Main">
      <details class="group relative lg:hidden">
        <summary class="cursor-pointer list-none rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">
          Menu
        </summary>
        <ul class="absolute right-0 mt-2 w-48 rounded-lg border border-slate-200 bg-white p-2 shadow-lg">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="block rounded-md px-3 py-2 text-sm text-slate-700 no-underline hover:bg-slate-100">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
      <ul class="hidden items-center gap-1 lg:flex">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path === item.href.replace(/\/$/, '') ? 'page' : undefined}
              class="rounded-md px-3 py-2 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-slate-900 aria-[current=page]:text-brand-700"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
