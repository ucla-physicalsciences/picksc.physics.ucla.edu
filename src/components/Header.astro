---
import { Image } from 'astro:assets';
import logo from '../assets/picksc-logo.png';
import { nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '');
---

<header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-3 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-3" aria-label="PICKSC home">
      <Image src={logo} alt="PICKSC" height={40} densities={[1, 2]} class="h-10 w-auto" />
      <span class="hidden border-l border-slate-200 pl-3 text-xs leading-tight text-slate-500 lg:block">
        UCLA Particle-in-Cell and Kinetic<br />Simulation Software Center
      </span>
    </a>

    <nav aria-label="Main">
      <details class="group relative md:hidden">
        <summary class="cursor-pointer list-none rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">
          Menu
        </summary>
        <ul class="absolute right-0 mt-2 w-48 rounded-lg border border-slate-200 bg-white p-2 shadow-lg">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="block rounded-md px-3 py-2 text-sm text-slate-700 no-underline hover:bg-slate-100">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
      <ul class="hidden items-center gap-1 md:flex">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
              class="rounded-md px-3 py-2 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-slate-900 aria-[current=page]:text-brand-700"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
